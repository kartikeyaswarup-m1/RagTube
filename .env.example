# Backend runtime configuration
# Copy to backend/.env for local development, or enter these values in Render.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

EMBED_PROVIDER=hf
HF_API_TOKEN=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Render's free filesystem is ephemeral. Keep this path writable.
VECTORSTORE_DIR=./backend/vectorstore

# Use localhost locally; replace with the Cloudflare Pages URL in Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional development fallback. Keep unset/false for real semantic search.
# ENABLE_EMBED_FALLBACK=0

# Optional only when using the HF generation provider instead of Groq.
# HF_MODEL=gpt2
